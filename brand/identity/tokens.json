{
  "name": "branded",
  "direction": "the-considered-cut",
  "colors": {
    "paper": "#f4f0e8",
    "paperDeep": "#e9e2d7",
    "ink": "#1a1b19",
    "inkSoft": "#555750",
    "lime": "#caff70",
    "coral": "#ff6a3d",
    "coralDisplay": "#eb542c",
    "focusBlue": "#5a7eff"
  },
  "typography": {
    "display": "Georgia, 'Times New Roman', serif",
    "body": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "utility": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "logo": {
    "symbolMinimumPx": 24,
    "faviconMinimumPx": 16,
    "lockupMinimumWidthPx": 140,
    "clearSpace": "at least one stem width on all sides"
  },
  "layout": {
    "contentMaxPx": 1200,
    "desktopGutterPx": 24,
    "mobileGutterPx": 16,
    "gridUnitPx": 8
  },
  "motion": {
    "tickerSeconds": 22,
    "reducedMotion": "disable continuous ticker and smooth scrolling"
  }
}
